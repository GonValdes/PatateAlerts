# Stock Alert Monitor Environment Variables
# Copy this file to .env and fill in your values
# See SETUP.md for detailed instructions on obtaining these values

# Telegram Bot Configuration
# Get bot token from @BotFather on Telegram
# Get chat ID by messaging your bot and visiting: https://api.telegram.org/bot<YOUR_BOT_TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN="your_bot_token_here"
TELEGRAM_CHAT_ID="your_chat_id_here"
